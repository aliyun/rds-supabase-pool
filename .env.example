# Copy to your shell environment or a local .env file.
# Never commit a filled-in copy.

# Required: existing RDS Supabase control-plane instance.
INSTANCE_NAME=ra-supabase-xxxxxxxx
REGION=cn-hangzhou
POOL_ADMIN_PASSWORD=replace-with-a-strong-password

# Required: RAM user credentials with the permissions documented in
# docs/deployment.md. Use a dedicated test account for evaluation.
ALIBABA_CLOUD_ACCESS_KEY_ID=replace-with-access-key-id
ALIBABA_CLOUD_ACCESS_KEY_SECRET=replace-with-access-key-secret

# mock: no cloud resources are created (default).
# real: creates billable PG and Supabase resources.
CLOUD_MODE=mock

# Optional overrides.
# SUPABASE_URL=https://<instance-domain>
# SUPABASE_SERVICE_KEY=replace-with-service-key
# CONTROL_DB_URL=postgres://<user>:<password>@<host>:5432/pool_control?sslmode=require
# CONTROL_ADMIN_DB_NAME=supabase_db
# CONTROL_ADMIN_DB_URL=postgres://<user>:<password>@<host>:5432/supabase_db?sslmode=require
# WORKER_TOKEN=replace-with-worker-token
# PLATFORM_JWT_SECRET=replace-with-jwt-secret
# AUTO_WHITELIST=true
# DEPLOY_UI=1
# SUPABASE_DASHBOARD_PASSWORD=replace-with-password
# SUPABASE_DATABASE_PASSWORD=replace-with-password
